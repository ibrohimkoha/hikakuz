# ========================================================
# Hikaku.uz Platform - Environment Configuration Example
# ========================================================

# Server Port
PORT=8199

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=nokori_go
DB_SSLMODE=disable

# Backblaze B2 Cloud Storage (S3-compatible)
B2_KEY_ID=your_backblaze_key_id
B2_APPLICATION_KEY=your_backblaze_application_key
B2_BUCKET_NAME=your_backblaze_bucket
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_BUCKET_ID=your_backblaze_bucket_id

# Telegram Auth & Notification Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_POST_BOT_TOKEN=your_telegram_post_bot_token
TELEGRAM_CHANNEL=@hikakuz
ADMIN_CHAT_ID=your_telegram_numeric_id

# Security Signatures & Secrets
JWT_SECRET=generate_random_64_char_secret_for_jwt
STREAM_SECRET=generate_random_64_char_secret_for_stream_hmac
SUPERADMIN_TOKEN_HASH=optional_sha256_hash_of_superadmin_master_token

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
